# Install: copy to /etc/systemd/system/, set WorkingDirectory and User, then
#   systemctl daemon-reload && systemctl enable --now inference-backup.timer
# A failed run leaves the unit in a failed state, visible in
#   systemctl --failed
# Hook OnFailure= to whatever alerts you. A job that fails silently is not running.
[Unit]
Description=Back up the inference stack with restic
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=inference
WorkingDirectory=/opt/SelfHostedLLMStack
ExecStart=/opt/SelfHostedLLMStack/scripts/backup.sh
Nice=10
