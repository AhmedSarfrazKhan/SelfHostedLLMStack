# Copy to .env, or run scripts/init_env.sh to generate one with random secrets.
# .env is gitignored and must never be committed.

# --- Hostnames -------------------------------------------------------------------
# *.localhost resolves to 127.0.0.1 without any DNS setup, which is enough for a
# single machine. For real names, point DNS at the host proxy or tunnel in front of
# the gateway and change all four lines together.
AUTH_HOST=auth.localhost
LLM_HOST=llm.localhost
AUTH_EXTERNAL_URL=http://auth.localhost:8480
LLM_EXTERNAL_URL=http://llm.localhost:8480

# Where the gateway listens on the host. Loopback by default.
GATEWAY_BIND=127.0.0.1
GATEWAY_PORT=8480

# --- Authentik -------------------------------------------------------------------
AUTHENTIK_SECRET_KEY=
AUTHENTIK_DB_PASSWORD=
# First boot only: the password for akadmin. Change it in the UI after logging in.
AUTHENTIK_BOOTSTRAP_PASSWORD=
AUTHENTIK_BOOTSTRAP_EMAIL=admin@example.invalid

# App password for the svc-assistant service account, used by remote clients as
# HTTP Basic against LLM_HOST. Services on this host use the internal listener and
# do not need it.
LLM_CLIENT_TOKEN=

# --- Ollama ----------------------------------------------------------------------
OLLAMA_MEM_LIMIT=3g
OLLAMA_CPUS=4
OLLAMA_CONTEXT_LENGTH=8192
OLLAMA_KEEP_ALIVE=5m

# --- Backups ---------------------------------------------------------------------
# restic runs in a pinned container, so nothing needs installing on the host.
# A local path is fine for trying it out. A local path is not a backup: the disk that
# holds it is the disk you are protecting against. Use an off-host repository in
# production, e.g. s3:https://s3.example.com/inference-backups or sftp:user@host:/path.
RESTIC_REPOSITORY=./backups/restic-repo
# The repository password lives in a file, not here, and is held by whoever owns
# the data. Lose it and every snapshot is unreadable. Keep a copy off this machine.
RESTIC_PASSWORD_FILE=./secrets/restic-password
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Extra named Docker volumes to include in every backup, space separated. This is
# how services built on this stack (the assistant's state, for example) get backed
# up and drilled without changing the scripts.
BACKUP_EXTRA_VOLUMES=

# Model weights are re-downloadable and pinned by digest, so they are excluded by
# default. Set to 1 to include them if the host may have to recover without internet.
BACKUP_MODELS=0

# The restore drill fails if a restore takes longer than this. A drill that passes
# no matter how long it takes does not tell you whether you meet your RTO.
DRILL_MAX_SECONDS=900
